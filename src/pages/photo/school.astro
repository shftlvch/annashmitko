import derevoBasketballPortrait from './school/_images/derevo/derevo-basketball-portrait.jpg';
import derevoBonfireCircle from './school/_images/derevo/derevo-bonfire-circle.jpg';
import derevoCourtyardSoccer from './school/_images/derevo/derevo-courtyard-soccer.jpg';
import derevoDoughBraidHands from './school/_images/derevo/derevo-dough-braid-hands.jpg';
import derevoGardenSnackCircle from './school/_images/derevo/derevo-garden-snack-circle.jpg';
import derevoHallwayBasketball from './school/_images/derevo/derevo-hallway-basketball.jpg';
import derevoHeartHandsPortrait from './school/_images/derevo/derevo-heart-hands-portrait.jpg';
