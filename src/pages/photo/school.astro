import derevoSpaceRangerHallway from './school/_images/derevo/derevo-space-ranger-hallway.jpg';
import derevoStarLightsPortrait from './school/_images/derevo/derevo-star-lights-portrait.jpg';
import derevoWaterDropsPortrait from './school/_images/derevo/derevo-water-drops-portrait.jpg';
import classroom01 from './school/_images/school-days/classroom-01.jpg';
import classroom02 from './school/_images/school-days/classroom-02.jpg';
import classroom03 from './school/_images/school-days/classroom-03.jpg';
import science01 from './school/_images/school-days/science-01.jpg';
import science02 from './school/_images/school-days/science-02.jpg';
import science03 from './school/_images/school-days/science-03.jpg';
import schoolDay01 from './school/_images/school-days/school-day-01.jpg';
import schoolDay02 from './school/_images/school-days/school-day-02.jpg';
import schoolDay03 from './school/_images/school-days/school-day-03.jpg';
import schoolDay04 from './school/_images/school-days/school-day-04.jpg';
import schoolDay05 from './school/_images/school-days/school-day-05.jpg';
import schoolPortrait01 from './school/_images/school-days/school-portrait-01.jpg';
import students01 from './school/_images/school-days/students-01.jpg';
import students02 from './school/_images/school-days/students-02.jpg';
import students03 from './school/_images/school-days/students-03.jpg';

const schoolGallery = [
  {
    image: schoolDay02,
    alt: 'Students gathered during a school day',
    class: 'md:col-span-5 md:col-start-1 md:mt-8',
  },
  { image: science01, alt: 'Children working during a science class', class: 'md:col-span-4 md:col-start-6' },
  { image: classroom01, alt: 'A quiet classroom moment', class: 'md:col-span-3 md:col-start-10 md:mt-14' },
  { image: students02, alt: 'Students in conversation at school', class: 'md:col-span-5 md:col-start-2 md:mt-18' },
  { image: schoolDay04, alt: 'Child focused during a lesson', class: 'md:col-span-4 md:col-start-8 md:mt-10' },
  {
    image: classroom03,
    alt: 'Students and teacher in a classroom',
    class: 'md:col-span-8 md:col-start-1 md:mt-14',
  },
  { image: science02, alt: 'Hands-on school science activity', class: 'md:col-span-4 md:col-start-9 md:mt-10' },
  { image: schoolPortrait01, alt: 'Portrait of a student', class: 'md:col-span-4 md:col-start-1 md:mt-18' },
  { image: classroom02, alt: 'Everyday school classroom scene', class: 'md:col-span-5 md:col-start-5 md:mt-8' },
  { image: schoolDay01, alt: 'Students walking through school', class: 'md:col-span-4 md:col-start-9 md:mt-20' },
  {
    image: students01,
    alt: 'Group of students during school activities',
    class: 'md:col-span-7 md:col-start-1 md:mt-12',
  },
  { image: science03, alt: 'Student experimenting in class', class: 'md:col-span-4 md:col-start-9 md:mt-20' },
  { image: schoolDay03, alt: 'School day documentary photograph', class: 'md:col-span-5 md:col-start-2 md:mt-18' },
  { image: schoolDay05, alt: 'Student portrait during school day', class: 'md:col-span-4 md:col-start-7 md:mt-8' },
  { image: students03, alt: 'Students outside the classroom', class: 'md:col-span-5 md:col-start-8 md:mt-18' },
];

const elifeletGallery = [
  { image: slimeCupPortrait, alt: 'Child holding a slime cup over one eye', class: 'md:col-span-5 md:col-start-1 md:mt-8' },
  { image: playhousePeekPortrait, alt: 'Child peeking through a wooden playhouse window', class: 'md:col-span-3 md:col-start-7 md:mt-2' },
  { image: boysOnStairs, alt: 'Four boys sitting together on school steps', class: 'md:col-span-4 md:col-start-10 md:mt-16' },
  { image: courtyardFootball, alt: 'Children playing football in the courtyard', class: 'md:col-span-4 md:col-start-2 md:mt-20' },
  { image: puppetPlay, alt: 'Child smiling with classroom puppets', class: 'md:col-span-5 md:col-start-7 md:mt-8' },
  { image: workbookStudy, alt: 'Two students working through a workbook', class: 'md:col-span-7 md:col-start-1 md:mt-14' },
  { image: hallwayBasketball, alt: 'Students with a basketball in a school hallway', class: 'md:col-span-4 md:col-start-9 md:mt-14' },
  { image: courtyardSoccer, alt: 'Child playing soccer alone in the courtyard', class: 'md:col-span-4 md:col-start-2 md:mt-18' },
  { image: basketballPortrait, alt: 'Student holding a basketball in the courtyard', class: 'md:col-span-4 md:col-start-7 md:mt-8' },
  { image: spaceRangerHallway, alt: 'Child running through a hallway in a space ranger costume', class: 'md:col-span-5 md:col-start-1 md:mt-20' },
  { image: princessCostumePortrait, alt: 'Child posing with a fan and parasol in a princess costume', class: 'md:col-span-3 md:col-start-8 md:mt-16' },
  { image: heartHandsPortrait, alt: 'Child smiling through hands shaped like a heart', class: 'md:col-span-5 md:col-start-7 md:mt-18' },
];

const derevoGallery = [
  { image: derevoPaintingWorkshop, alt: 'Black-and-white photograph of a child painting during an outdoor workshop', class: 'md:col-span-5 md:col-start-1 md:mt-8' },
  { image: derevoBarefootLog, alt: 'Bare feet balancing on a log in the grass', class: 'md:col-span-3 md:col-start-7 md:mt-2' },
  { image: derevoHoopBallPortrait, alt: 'Black-and-white portrait of a child beside a ball in the grass', class: 'md:col-span-4 md:col-start-10 md:mt-16' },
  { image: derevoRibbonRun, alt: 'Adult and child running through hanging ribbons outdoors', class: 'md:col-span-5 md:col-start-2 md:mt-20' },
  { image: derevoStarLightsPortrait, alt: 'Child looking at glowing star lights', class: 'md:col-span-4 md:col-start-8 md:mt-8' },
  { image: derevoBonfireCircle, alt: 'People holding hands in a circle around a bonfire at night', class: 'md:col-span-7 md:col-start-1 md:mt-14' },
  { image: derevoGardenSnackCircle, alt: 'Black-and-white photograph of children and an adult sitting together in a garden', class: 'md:col-span-4 md:col-start-9 md:mt-16' },
  { image: derevoWaterDropsPortrait, alt: 'Black-and-white portrait of a child playing with water drops', class: 'md:col-span-5 md:col-start-2 md:mt-18' },
  { image: derevoDoughBraidHands, alt: 'Hands braiding dough on a table', class: 'md:col-span-4 md:col-start-7 md:mt-8' },
  { image: derevoHallwayBasketball, alt: 'Children with a basketball in a school hallway', class: 'md:col-span-5 md:col-start-1 md:mt-20' },
  { image: derevoCourtyardSoccer, alt: 'Child playing soccer alone in a courtyard', class: 'md:col-span-4 md:col-start-8 md:mt-10' },
  { image: derevoBasketballPortrait, alt: 'Student holding a basketball in a courtyard', class: 'md:col-span-4 md:col-start-2 md:mt-18' },
  { image: derevoSpaceRangerHallway, alt: 'Child running through a hallway in a space ranger costume', class: 'md:col-span-5 md:col-start-7 md:mt-8' },
  { image: derevoPrincessCostumePortrait, alt: 'Child posing with a fan and parasol in a princess costume', class: 'md:col-span-3 md:col-start-1 md:mt-20' },
  { image: derevoHeartHandsPortrait, alt: 'Child smiling through hands shaped like a heart', class: 'md:col-span-5 md:col-start-7 md:mt-18' },
];

const sections = [
  {
    title: 'School and outdoor activities',
    subtitle: 'A documentary sequence from everyday school life, moving between classrooms, lessons, breaks, and outdoor activities. The photographs follow children through structured learning and unscripted moments of play, attention, fatigue, and movement.',
    items: schoolGallery,
  },
  {
    title: 'Elifelet: children of asylum seekers',
    subtitle: 'Elifelet is an Israeli nonprofit supporting children of asylum seekers and refugees in south Tel Aviv, especially young children from Eritrean and Sudanese communities. Its work is closer to early-childhood care, after-school support, welfare, and emergency aid than to a conventional school system. These photographs look at children in the learning and care spaces created around that need.',
    items: elifeletGallery,
  },
  {
    title: 'Derevo: family camp',
    subtitle: 'A family camp for Ukrainian children with special needs, supported through an NGO setting. The section follows days built around outdoor workshops, play, shared meals, handmade objects, and evening rituals, with attention to the children and families moving through the camp together.',
    items: derevoGallery,
  },
];

let lightboxIndex = 0;

const gallerySections = await Promise.all(
  sections.map(async (section) => ({
    ...section,
    items: await Promise.all(
      section.items.map(async (item) => ({
        ...item,
        lightboxIndex: lightboxIndex++,
        lightbox: await getImage({ src: item.image, width: 1800, format: 'webp', quality: 82 }),
      })),
    ),
  })),
);
---

<Layout title="School Photography — Anna Shmitko">
  <main class="min-h-screen px-4 py-5 md:px-8 md:py-6">
    <div class="container mx-auto max-w-7xl">
      <header class="grid gap-4 text-sm font-semibold leading-tight text-black md:grid-cols-12 md:text-[13px]">
        <div class="md:col-span-2">
          <a href="/photo" class="transition-colors hover:text-gray-500">Anna Shmitko</a>
        </div>
        <div class="md:col-span-3">
          <h1>School photography</h1>
        </div>
        <p class="max-w-sm md:col-span-3 md:col-start-7">
          Documentary photographs of school life, lessons, pauses, experiments, and movement.
        </p>
        <div class="hidden text-right md:col-span-2 md:col-start-11 md:block">
          / photo archive
        </div>
      </header>

      <portfolio-gallery>
        {
          gallerySections.map((section, sectionIndex) => (
            <section class={sectionIndex === 0 ? 'pt-28 md:pt-44' : 'pt-24 md:pt-40'}>
              <div class="grid gap-4 text-sm font-semibold leading-tight text-black md:grid-cols-12 md:text-[13px]">
                <div class="md:col-span-2">{String(sectionIndex + 1).padStart(2, '0')}</div>
                <h2 class="md:col-span-3">{section.title}</h2>
                <p class="max-w-sm md:col-span-3 md:col-start-7">{section.subtitle}</p>
              </div>

              <div class="mt-12 grid items-start gap-y-9 md:mt-16 md:grid-cols-12 md:gap-x-6 md:gap-y-0">
                {section.items.map((item) => (
                  <figure class={item.class}>
                    <button
                      type="button"
                      data-lightbox-index={item.lightboxIndex}
                      data-lightbox-src={item.lightbox.src}
                      data-lightbox-alt={item.alt}
                      aria-label={`Open image ${item.lightboxIndex + 1}`}
                      class="block w-full cursor-zoom-in text-left"
                    >
                      <Image
                        src={item.image}
                        alt={item.alt}
                        widths={[360, 640, 900]}
                        sizes={item.class?.includes('col-span-8') || item.class?.includes('col-span-7') ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 768px) 40vw, 100vw'}
                        format="webp"
                        quality={72}
                        loading={item.lightboxIndex < 3 ? 'eager' : 'lazy'}
                        class="h-auto w-full"
                      />
                    </button>
                  </figure>
                ))}
              </div>
            </section>
          ))
        }

        <div
          data-lightbox
          class="fixed inset-0 z-50 hidden h-svh w-screen bg-black/95 px-4 py-4 text-white backdrop-blur-sm md:px-8 md:py-6"
          role="dialog"
          aria-modal="true"
          aria-hidden="true"
        >
          <div class="flex h-full min-h-0 flex-col">
            <div class="relative z-20 grid grid-cols-[1fr_auto] items-center gap-3 text-sm font-semibold leading-tight text-white/90 md:grid-cols-12 md:text-[13px]">
              <div class="hidden md:col-span-2 md:block">Anna Shmitko</div>
              <div class="hidden md:col-span-3 md:block">School photography</div>
              <div class="md:col-span-2 md:col-start-7" data-lightbox-counter></div>
              <button
                type="button"
                data-lightbox-close
                class="min-h-11 min-w-16 border border-white/30 px-4 text-center transition-colors hover:border-white hover:text-white active:bg-white active:text-black md:col-span-2 md:col-start-11 md:justify-self-end"
              >
                close
              </button>
            </div>

            <div data-lightbox-stage class="relative -mx-4 flex min-h-0 flex-1 touch-pan-y items-center justify-center px-14 py-4 md:-mx-8 md:px-24 md:py-8">
              <button
                type="button"
                data-lightbox-prev
                class="absolute inset-y-0 left-0 z-10 flex w-14 items-center justify-center bg-black/20 text-4xl leading-none text-white/85 transition-colors hover:text-white active:bg-white active:text-black md:w-24 md:text-6xl"
                aria-label="Previous image"
              >
                &lt;-
              </button>
              <img
                data-lightbox-image
                alt=""
                draggable="false"
                class="max-h-[calc(100svh-8rem)] max-w-full select-none object-contain md:max-h-[calc(100svh-7rem)]"
              />
              <button
                type="button"
                data-lightbox-next
                class="absolute inset-y-0 right-0 z-10 flex w-14 items-center justify-center bg-black/20 text-4xl leading-none text-white/85 transition-colors hover:text-white active:bg-white active:text-black md:w-24 md:text-6xl"
                aria-label="Next image"
              >
                -&gt;
              </button>
            </div>

            <div class="pb-1 text-center text-xs font-semibold text-white/45 md:hidden">swipe or tap arrows</div>
          </div>
        </div>
      </portfolio-gallery>
    </div>
  </main>
</Layout>

<script>
  class PortfolioGallery extends HTMLElement {
    private triggers: HTMLButtonElement[] = [];
    private lightbox: HTMLElement | null = null;
    private stage: HTMLElement | null = null;
    private image: HTMLImageElement | null = null;
    private counter: HTMLElement | null = null;
    private closeButton: HTMLButtonElement | null = null;
    private prevButton: HTMLButtonElement | null = null;
    private nextButton: HTMLButtonElement | null = null;
    private index = 0;
    private previousBodyOverflow = '';
    private previousDocumentOverflow = '';
    private touchStartX = 0;
    private touchStartY = 0;
    private touchStartTime = 0;
    private boundKeydown = this.handleKeydown.bind(this);
    private boundTouchStart = this.handleTouchStart.bind(this);
    private boundTouchEnd = this.handleTouchEnd.bind(this);

    connectedCallback() {
      this.triggers = Array.from(this.querySelectorAll('[data-lightbox-index]'));
      this.lightbox = this.querySelector('[data-lightbox]');
      this.stage = this.querySelector('[data-lightbox-stage]');
      this.image = this.querySelector('[data-lightbox-image]');
      this.counter = this.querySelector('[data-lightbox-counter]');
      this.closeButton = this.querySelector('[data-lightbox-close]');
      this.prevButton = this.querySelector('[data-lightbox-prev]');
      this.nextButton = this.querySelector('[data-lightbox-next]');

      this.triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          this.open(Number(trigger.dataset.lightboxIndex || 0));
        });
      });

      this.closeButton?.addEventListener('click', () => this.close());
      this.prevButton?.addEventListener('click', () => this.showPrevious());
      this.nextButton?.addEventListener('click', () => this.showNext());
      this.stage?.addEventListener('touchstart', this.boundTouchStart, { passive: true });
      this.stage?.addEventListener('touchend', this.boundTouchEnd, { passive: true });
    }

    disconnectedCallback() {
      document.removeEventListener('keydown', this.boundKeydown);
      document.body.style.overflow = this.previousBodyOverflow;
      document.documentElement.style.overflow = this.previousDocumentOverflow;
      this.stage?.removeEventListener('touchstart', this.boundTouchStart);
      this.stage?.removeEventListener('touchend', this.boundTouchEnd);
    }

    private open(index: number) {
      this.index = index;
      this.render();
      this.lightbox?.classList.remove('hidden');
      this.lightbox?.setAttribute('aria-hidden', 'false');
      this.previousBodyOverflow = document.body.style.overflow;
      this.previousDocumentOverflow = document.documentElement.style.overflow;
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', this.boundKeydown);
      this.closeButton?.focus();
    }

    private close() {
      this.lightbox?.classList.add('hidden');
      this.lightbox?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = this.previousBodyOverflow;
      document.documentElement.style.overflow = this.previousDocumentOverflow;
      document.removeEventListener('keydown', this.boundKeydown);
      this.triggers[this.index]?.focus();
    }

    private showPrevious() {
      this.index = (this.index - 1 + this.triggers.length) % this.triggers.length;
      this.render();
    }

    private showNext() {
      this.index = (this.index + 1) % this.triggers.length;
      this.render();
    }

    private render() {
      const trigger = this.triggers[this.index];

      if (!trigger || !this.image) {
        return;
      }

      this.image.src = trigger.dataset.lightboxSrc || '';
      this.image.alt = trigger.dataset.lightboxAlt || '';

      if (this.counter) {
        this.counter.textContent = `${String(this.index + 1).padStart(2, '0')} / ${String(this.triggers.length).padStart(2, '0')}`;
      }
    }

    private handleKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        this.close();
      }

      if (event.key === 'ArrowLeft') {
        this.showPrevious();
      }

      if (event.key === 'ArrowRight') {
        this.showNext();
      }
    }

    private handleTouchStart(event: TouchEvent) {
      const touch = event.changedTouches[0];

      if (!touch) {
        return;
      }

      this.touchStartX = touch.clientX;
      this.touchStartY = touch.clientY;
      this.touchStartTime = Date.now();
    }

    private handleTouchEnd(event: TouchEvent) {
      const touch = event.changedTouches[0];

      if (!touch) {
        return;
      }

      const deltaX = touch.clientX - this.touchStartX;
      const deltaY = touch.clientY - this.touchStartY;
      const isHorizontalSwipe = Math.abs(deltaX) > 48 && Math.abs(deltaX) > Math.abs(deltaY) * 1.4;
      const isQuickSwipe = Date.now() - this.touchStartTime < 900;

      if (!isHorizontalSwipe || !isQuickSwipe) {
        return;
      }

      if (deltaX > 0) {
        this.showPrevious();
        return;
      }

      this.showNext();
    }
  }

  if (!customElements.get('portfolio-gallery')) {
    customElements.define('portfolio-gallery', PortfolioGallery);
  }
</script>
