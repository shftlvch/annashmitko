---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import classroom01 from './school/_images/classroom-01.jpg';
import classroom02 from './school/_images/classroom-02.jpg';
import classroom03 from './school/_images/classroom-03.jpg';
import science01 from './school/_images/science-01.jpg';
import science02 from './school/_images/science-02.jpg';
import science03 from './school/_images/science-03.jpg';
import schoolDay01 from './school/_images/school-day-01.jpg';
import schoolDay02 from './school/_images/school-day-02.jpg';
import schoolDay03 from './school/_images/school-day-03.jpg';
import schoolDay04 from './school/_images/school-day-04.jpg';
import schoolDay05 from './school/_images/school-day-05.jpg';
import schoolPortrait01 from './school/_images/school-portrait-01.jpg';
import students01 from './school/_images/students-01.jpg';
import students02 from './school/_images/students-02.jpg';
import students03 from './school/_images/students-03.jpg';

const gallery = [
  {
    image: schoolDay02,
    alt: 'Students gathered during a school day',
    class: 'md:col-span-4 md:col-start-1 md:mt-10',
  },
  { image: science01, alt: 'Children working during a science class', class: 'md:col-span-3 md:col-start-6' },
  { image: classroom01, alt: 'A quiet classroom moment', class: 'md:col-span-4 md:col-start-10 md:mt-20' },
  { image: students02, alt: 'Students in conversation at school', class: 'md:col-span-5 md:col-start-3 md:mt-28' },
  { image: schoolDay04, alt: 'Child focused during a lesson', class: 'md:col-span-3 md:col-start-9 md:mt-8' },
  {
    image: classroom03,
    alt: 'Students and teacher in a classroom',
    class: 'md:col-span-8 md:col-start-1 md:mt-16',
  },
  { image: science02, alt: 'Hands-on school science activity', class: 'md:col-span-3 md:col-start-10 md:-mt-12' },
  { image: schoolPortrait01, alt: 'Portrait of a student', class: 'md:col-span-3 md:col-start-2 md:mt-36' },
  { image: classroom02, alt: 'Everyday school classroom scene', class: 'md:col-span-5 md:col-start-6 md:mt-6' },
  { image: schoolDay01, alt: 'Students walking through school', class: 'md:col-span-4 md:col-start-9 md:mt-24' },
  {
    image: students01,
    alt: 'Group of students during school activities',
    class: 'md:col-span-7 md:col-start-1 md:mt-10',
  },
  { image: science03, alt: 'Student experimenting in class', class: 'md:col-span-4 md:col-start-9 md:mt-36' },
  { image: schoolDay03, alt: 'School day documentary photograph', class: 'md:col-span-4 md:col-start-2 md:mt-24' },
  { image: schoolDay05, alt: 'Student portrait during school day', class: 'md:col-span-3 md:col-start-7 md:mt-4' },
  { image: students03, alt: 'Students outside the classroom', class: 'md:col-span-5 md:col-start-8 md:mt-28' },
];
---

<Layout title="School Photography — Anna Shmitko">
  <main class="min-h-screen px-4 py-5 md:px-8 md:py-6">
    <div class="container mx-auto max-w-7xl">
      <header class="grid gap-4 text-sm font-semibold leading-tight text-black md:grid-cols-12 md:text-[13px]">
        <div class="md:col-span-2">
          <a href="/photo" class="transition-colors hover:text-gray-500">Anna Shmitko</a>
        </div>
        <div class="md:col-span-3">
          <h1>School photography</h1>
        </div>
        <p class="max-w-sm md:col-span-3 md:col-start-7">
          Documentary photographs of school life, lessons, pauses, experiments, and movement.
        </p>
        <div class="hidden text-right md:col-span-2 md:col-start-11 md:block">
          / photo archive
        </div>
      </header>

      <section class="pt-36 md:pt-56">
        <div class="grid items-start gap-y-10 md:grid-cols-12 md:gap-x-6 md:gap-y-0">
          <div class="hidden text-[13px] font-semibold leading-tight text-black md:col-span-1 md:block">
            <a
              href="/photo"
              class="sticky top-6 block transition-colors hover:text-gray-500"
            >
              photo<br />index
            </a>
          </div>
          {
            gallery.map((item, index) => (
              <figure class={item.class}>
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[360, 640, 900]}
                  sizes={item.class?.includes('col-span-8') || item.class?.includes('col-span-7') ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 768px) 40vw, 100vw'}
                  format="webp"
                  quality={72}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  class="h-auto w-full"
                />
              </figure>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
